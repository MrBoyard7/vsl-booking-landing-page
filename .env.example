# Copy this file to .env and fill in real values before deploying.
# .env itself is git-ignored — never commit real API keys.

# --- App -------------------------------------------------------------
PORT=3000

# Set to "true" to run the site fully locally without calling MailerLite
# or Zoho CRM at all (both integrations log a warning and return a
# simulated success instead). Useful for local development and for CI.
MOCK_INTEGRATIONS=true

# --- MailerLite --------------------------------------------------------
# Create a token at: MailerLite dashboard > Integrations > Developer API
MAILERLITE_API_KEY=
# Optional: the group new leads should be added to.
MAILERLITE_GROUP_ID=

# --- Zoho CRM ------------------------------------------------------------
# Create a "Server-based Application" at https://api-console.zoho.com,
# then generate a refresh token with the ZohoCRM.modules.leads.CREATE scope.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Must match the data center your Zoho account lives in.
ZOHO_ACCOUNT_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
