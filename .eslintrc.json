{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": ["error", "smart"],
    "no-var": "off"
  },
  "overrides": [
    {
      "files": ["api/**/*.js", "server/**/*.js", "build.js"],
      "parserOptions": {
        "sourceType": "script"
      },
      "env": {
        "node": true,
        "browser": false
      }
    }
  ]
}
